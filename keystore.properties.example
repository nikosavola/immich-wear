# Copy to keystore.properties (gitignored) and fill in to sign :wear and :mobile release builds
# with a real key. Both modules read this same file - see the comment in their build.gradle.kts
# for why they must share one key. Without this file, release builds fall back to debug signing.
#
# Alternatively, set these as environment variables (e.g. in CI) instead of a file:
# RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD, RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD

# Path relative to the repo root
RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
