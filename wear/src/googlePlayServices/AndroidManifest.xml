<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Receives the server URL/API key sent by the phone companion app; see
             datalayer/PhoneLoginListenerService.kt and res/values/wear.xml (both under this same
             src/googlePlayServices/ source set, wired into direct and playstore only). -->
        <service android:name=".datalayer.PhoneLoginListenerService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/immich/login/request" />
            </intent-filter>
        </service>

    </application>

</manifest>
