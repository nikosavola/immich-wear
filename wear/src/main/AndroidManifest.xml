<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: most self-hosted Immich servers run on a home LAN without TLS
         (the official Immich apps support this too). Rejecting http:// server URLs outright would
         break that common setup; the server address is a value the user explicitly typed in
         Settings, not a URL fetched from an untrusted source. -->
    <application
        android:name=".ImmichApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault"
        android:usesCleartextTraffic="true">

        <!-- Required for the app to show up as a standalone Wear OS listing (not phone-tethered). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:taskAffinity="fi.nikosavola.immichwear.main"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
