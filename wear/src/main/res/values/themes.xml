<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MainActivity's theme only until installSplashScreen() dismisses it, then Android switches
         to postSplashScreenTheme automatically - see MainActivity.onCreate(). Black background and
         the launcher's own foreground layer satisfy the Wear OS Play Store splash screen guideline
         (WO-V15): a 48x48dp icon matching the launcher, on black. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@android:style/Theme.DeviceDefault</item>
    </style>
</resources>
