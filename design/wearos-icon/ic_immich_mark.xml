<?xml version="1.0" encoding="utf-8"?>
<!-- Immich Wear OS companion - single-colour app mark. Tint with the Material 3 dynamic scheme,
     e.g. MaterialTheme.colorScheme.primary, so it follows the watch's system theme colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="?attr/colorControlNormal">
    <!-- watch crown -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M85.5,48 A3.5,3.5 0 0 1 89,51.5 V56.5 A3.5,3.5 0 0 1 85.5,60 H82 V48 Z" />
    <!-- watch case -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="5.5"
        android:fillColor="#00000000"
        android:pathData="M24,54 A30,30 0 1 1 84,54 A30,30 0 1 1 24,54 Z" />
    <!-- dial: sun and mountains -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M64,37 A5,5 0 1 1 64,47 A5,5 0 1 1 64,37 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M35,68 L47,49 L58,68 Z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M46,68 L61,51 L73,68 Z" />
</vector>
